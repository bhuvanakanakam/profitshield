OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=google/gemini-2.5-flash
# SQUARE_ACCESS_TOKEN=EAAA-your-sandbox-token

# Square is always sandbox-only. SQUARE_ENV cannot select production.
# Only use a Square sandbox token.
# Exact browser origin for reviewed mutation requests (default shown):
# PROFITSHIELD_ORIGIN=http://localhost:8000

# External AI stays OFF even with a key until privacy policy approval.
# Do not enable for real financial documents without explicit owner approval.
# PROFITSHIELD_AI_PRIVACY_APPROVED=true
